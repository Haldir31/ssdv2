# Copier vers ~/.config/ssd/cloudflare.env (chmod 600) puis lancer avec
# SSD_CF_DNS=1 :  ./includes/nativeapps/cloudflare_dns.sh
# ou automatiquement :  SSD_CF_DNS=1 ./includes/nativeapps/install_native_app.sh traefik
#
# Token requis : Account > Cloudflare Tunnel (Read+Write) + Zone > DNS (Write).
CF_API_TOKEN=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSD_TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SSD_DOMAIN=example.com
# CF_ZONE_ID : optionnel — sinon résolu via GET /zones?name=$SSD_DOMAIN
# (nécessite Zone:Read ; sinon renseigner l'ID ici)
#CF_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
